# MySQL (either MYSQL_DSN or project-scoped vars)
# MYSQL_DSN=mysql://user:password@127.0.0.1:3306/ImageTracker?charset=utf8mb4
# IMAGETRACKER_MYSQL_HOST=127.0.0.1
# IMAGETRACKER_MYSQL_PORT=3306
# IMAGETRACKER_MYSQL_USER=user
# IMAGETRACKER_MYSQL_PASSWORD=password
# IMAGETRACKER_MYSQL_DATABASE=ImageTracker

# Compatibility fallbacks
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USERID=user
# MYSQL_PASSWORD=password
# MYSQL_DATABASE_IMAGETRACKER=ImageTracker

# OpenAI credential (process environment first, then ignored .env, then SSM)
OPENAI_API_KEY=
# Legacy monolith only; the app worker uses IAM-authenticated Amazon Location.
GOOGLE_MAPS_API_KEY=

# Legacy ImageTracker.py direct captioning
OPENAI_VISION_MODEL=gpt-5.2
PHOTO_CAPTION_MAX_WORDS=18

# Legacy ImageTracker.py location enrichment
LOCATION_NORMALIZATION_RULES_PATH=location_normalization_rules.json

# App foundation (non-secret values only)
IMAGETRACKER_STAGE=local
IMAGETRACKER_AWS_REGION=us-east-2
IMAGETRACKER_API_URL=
IMAGETRACKER_MEDIA_BUCKET=
IMAGETRACKER_DB_SECRET_PARAMETER=/imagetracker/prod/mysql
IMAGETRACKER_OPENAI_SECRET_PARAMETER=/imagetracker/prod/openai
IMAGETRACKER_ELEVENLABS_SECRET_PARAMETER=/imagetracker/prod/elevenlabs
IMAGETRACKER_LOCATION_NORMALIZATION_RULES_PATH=location_normalization_rules.json
IMAGETRACKER_GEOCODE_REUSE_RADIUS_METERS=5
IMAGETRACKER_GEOCODE_MONTHLY_CALL_LIMIT=1000
IMAGETRACKER_SCENE_DESCRIPTION_MODEL=gpt-5.6-sol
IMAGETRACKER_SCENE_DESCRIPTION_DETAIL=high
IMAGETRACKER_SCENE_DESCRIPTION_SERVICE_TIER=flex
IMAGETRACKER_SCENE_DESCRIPTION_MAX_WORDS=24
IMAGETRACKER_SCENE_DESCRIPTION_MONTHLY_CALL_LIMIT=1000
